{
  "name": "my-components",
  "version": "0.0.1",
  "description": "Stencil Component Starter",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/my-components/my-components.esm.js",
  "exports": {
    ".": {
      "import": "./dist/my-components/my-components.esm.js",
      "require": "./dist/my-components/my-components.cjs.js"
    },
    "./dist/components/*": {
      "import": "./dist/components/*"
    },
    "./loader": {
      "import": "./loader/index.js",
      "require": "./loader/index.cjs",
      "types": "./loader/index.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stenciljs/component-starter.git"
  },
  "files": [
    "dist/",
    "loader/"
  ],
  "scripts": {
    "build": "stencil build",
    "coverage": "stencil build && vitest run --coverage",
    "docs": "stencil build --docs",
    "format": "prettier --write 'src/**/*.{css,html,js,ts,tsx}'",
    "start": "stencil build --dev --watch --serve",
    "test": "stencil build && vitest run",
    "test.e2e": "stencil build && vitest run --project browser",
    "test.spec": "stencil build && vitest run --project spec",
    "test.watch": "stencil-test --watch",
    "generate": "stencil generate"
  },
  "devDependencies": {
    "@stencil/core": "^4.27.1",
    "@stencil/react-output-target": "^1.4.2",
    "@stencil/vitest": "^1.14.0",
    "@types/node": "^22.13.5",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "prettier": "^3.8.1",
    "vitest": "^4.1.10"
  },
  "license": "MIT"
}
